# Core application settings
APP_ENV=development
FRONTEND_BASE_URL=http://localhost:3000

# HKUST(GZ) Campus SSO. Keep real credentials in deployment secrets, never in
# this file or source control. Enable only after the school registers the exact
# callback and post-logout URLs below.
CAMPUS_SSO_ENABLED=false
CAMPUS_SSO_CLIENT_ID=
CAMPUS_SSO_CLIENT_SECRET=
CAMPUS_SSO_ISSUER=https://devsso.hkust-gz.edu.cn
CAMPUS_SSO_METADATA_URL=https://devsso.hkust-gz.edu.cn/.well-known/openid-configuration
CAMPUS_SSO_END_SESSION_ENDPOINT=https://devsso.hkust-gz.edu.cn/connect/endsession
CAMPUS_SSO_REDIRECT_URI=https://unikorn.hkust-gz.edu.cn/api/auth/oidc/callback
CAMPUS_SSO_POST_LOGOUT_REDIRECT_URI=https://unikorn.hkust-gz.edu.cn/
CAMPUS_SSO_SCOPES=openid profile

# Use true on HTTPS deployments. Local HTTP-only tests may set these to false.
CAMPUS_SSO_COOKIE_SECURE=false

# Comma-separated, verified school-email allowlist for the MeetCampus private beta.
# Set this to an empty value to disable access for everyone.
MEETCAMPUS_BETA_EMAILS=wtao565@connect.hkust-gz.edu.cn
SESSION_COOKIE_SECURE=false

# NODE recruitment one-prompt Agent challenge. Keep the real model key out of
# source control; the challenge reports unavailable when this key is absent.
DASHSCOPE_API_KEY=
RECRUITMENT_CHALLENGE_ENABLED=true
RECRUITMENT_AGENT_MODEL=qwen-plus
RECRUITMENT_AGENT_MAX_ROUNDS=8
RECRUITMENT_AGENT_MAX_TOOL_CALLS=20
RECRUITMENT_AGENT_TIMEOUT_SECONDS=12
RECRUITMENT_ATTEMPT_TTL_SECONDS=2592000

# Production uses https://sso.hkust-gz.edu.cn for the issuer, metadata, and
# end-session endpoint. The production workflow supplies these exact values.

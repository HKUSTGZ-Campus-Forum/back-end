[Unit]
Description=Capture uniKorn scheduler popularity every five minutes

[Timer]
# Sampling is deliberately bounded to the 2026 add/drop tracking window.  An
# immediate deployment baseline covers the partial first bucket.
OnCalendar=2026-08-* *:0/5:00 Asia/Shanghai
OnCalendar=2026-09-* *:0/5:00 Asia/Shanghai
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=unikorn-scheduler-popularity-sample.service

[Install]
WantedBy=timers.target

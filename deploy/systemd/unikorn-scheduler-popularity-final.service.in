[Unit]
Description=Capture the final uniKorn scheduler popularity sample
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=180s
StartLimitBurst=12

[Service]
Type=oneshot
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__SAMPLER_DIR__
EnvironmentFile=-__APP_ENV_FILE__
Environment=ENABLE_BACKGROUND_TASKS=false
Environment=AUTO_INIT_ON_STARTUP=false
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PGCONNECT_TIMEOUT=10
ExecStart=__PYTHON__ __SAMPLER_DIR__/scripts/sample_scheduler_popularity.py --semester 2610 --expected-database prod_unikorn --terminal --terminal-tolerance-seconds 120 --lock-wait-seconds 5
ExecStartPost=__PYTHON__ __SAMPLER_DIR__/scripts/sample_scheduler_popularity.py --semester 2610 --expected-database prod_unikorn --verify-terminal
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

# Copy to /etc/unikorn/unikorn.env, set ownership root:unikorn and mode 0640.
# Values follow systemd EnvironmentFile quoting. Double-quote values that contain
# whitespace or shell metacharacters; do not use shell command substitution.
APP_ENV=production
FLASK_APP=wsgi:application
DATABASE_URL=postgresql:///prod_unikorn
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_TYPE=redis
FRONTEND_BASE_URL=https://unikorn.hkust-gz.edu.cn
NUXT_PUBLIC_API_BASE_URL=
NUXT_API_INTERNAL_BASE_URL=http://127.0.0.1:8081

# Generate independent, high-entropy values. Never copy these placeholders.
SECRET_KEY=
JWT_SECRET_KEY=

# The upstream school gateway and local Nginx are normalized into one trusted
# header hop before Flask. Do not increase these values without a proxy audit.
TRUSTED_PROXY_FOR_HOPS=1
TRUSTED_PROXY_PROTO_HOPS=1
SESSION_COOKIE_SECURE=true
CAMPUS_SSO_COOKIE_SECURE=true

# Keep legacy login available until campus SSO has passed end-to-end acceptance.
CAMPUS_SSO_ENABLED=false
CAMPUS_SSO_CLIENT_ID=unikorn.client
CAMPUS_SSO_CLIENT_SECRET=
CAMPUS_SSO_ISSUER=https://sso.hkust-gz.edu.cn
CAMPUS_SSO_METADATA_URL=https://sso.hkust-gz.edu.cn/.well-known/openid-configuration
CAMPUS_SSO_END_SESSION_ENDPOINT=https://sso.hkust-gz.edu.cn/connect/endsession
CAMPUS_SSO_REDIRECT_URI=https://unikorn.hkust-gz.edu.cn/api/auth/oidc/callback
CAMPUS_SSO_POST_LOGOUT_REDIRECT_URI=https://unikorn.hkust-gz.edu.cn/
CAMPUS_SSO_SCOPES="openid profile"

ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_ROLE_ARN=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_REGION_ID=cn-hangzhou
OSS_TOKEN_DURATION=3600
OSS_PUBLIC_URL=

ALIBABA_DM_REGION=ap-southeast-1
ALIBABA_DM_ACCOUNT_NAME=
ALIBABA_DM_FROM_ALIAS="uniKorn 校园论坛"
ALIBABA_CLOUD_EMAIL_SMTP_SECRET=

DASHSCOPE_API_KEY=
DASHVECTOR_API_KEY=
DASHVECTOR_ENDPOINT=
RECRUITMENT_CHALLENGE_ENABLED=true
RECRUITMENT_AGENT_MODEL=qwen-plus
RECRUITMENT_AGENT_MAX_ROUNDS=8
RECRUITMENT_AGENT_MAX_TOOL_CALLS=20
RECRUITMENT_AGENT_TIMEOUT_SECONDS=12
RECRUITMENT_ATTEMPT_TTL_SECONDS=2592000
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=

AUTO_INIT_ON_STARTUP=true
# Gunicorn must not start duplicate schedulers. The dedicated systemd worker
# overrides this to true for exactly one process.
ENABLE_BACKGROUND_TASKS=false
EMBEDDING_MAINTENANCE_INTERVAL_MINUTES=60
EMBEDDING_MAINTENANCE_BATCH_SIZE=50
EMBEDDING_MAINTENANCE_MAX_TIME_MINUTES=30

# Official SISN snapshots are fetched by the co-located CoursePlan service and
# pushed directly to the loopback-only Flask listener with Ed25519 signatures.
SISN_SYNC_TERM=2610
SISN_SYNC_BASELINE_PATH=/srv/unikorn/current/backend/app/data/pending/scheduler_offerings/26-27fall.json
SISN_SYNC_ARCHIVE_DIR=/srv/unikorn/sisn-archive
SISN_SYNC_MAX_BASELINE_MEETING_FALLBACK_SECTIONS=50
SISN_PUSH_INGEST_ENABLED=true
SISN_PUSH_PUBLIC_KEY_PATH=/etc/unikorn/sisn-push-public.pem

# PCC is authoritative for course titles, descriptions, prerequisites,
# corequisites, and exclusions. Keep disabled until the first guarded catalog
# migration has completed successfully in this environment.
COURSE_CATALOG_SYNC_ENABLED=false
COURSE_CATALOG_SYNC_TERM=2610
COURSE_CATALOG_SYNC_CAREER=UG
COURSE_CATALOG_SYNC_INTERVAL_HOURS=6
